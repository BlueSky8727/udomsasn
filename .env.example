# URL ภายในที่ Next.js server ใช้เรียก NestJS
BACKEND_URL=http://localhost:4000/api

# URL ที่ browser ใช้เฉพาะกรณีต้องอ้างอิง backend โดยตรง
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
# เปิดเฉพาะเมื่อ reverse proxy เขียนทับ CF/X-Real-IP/X-Forwarded-For จากผู้ใช้
TRUST_PROXY_HEADERS=false

# OpenTyphoon — เก็บเฉพาะฝั่ง Next.js server ห้ามใช้ NEXT_PUBLIC_
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TEMPERATURE=0.2
TYPHOON_MAX_TOKENS=1800
AI_CHECK_ENABLED=true
