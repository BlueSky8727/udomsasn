# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit .env.local เข้า git

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# URL และ anon key เปิดเผยต่อ browser ได้ (RLS เป็นตัวคุมสิทธิ์)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key ข้าม RLS ทั้งหมด
# ใช้ได้เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามใช้ในเส้นทางที่รับข้อมูลจากผู้ใช้โดยตรง
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Storage (กฎเหล็กข้อ 6: private bucket + signed URL เท่านั้น)
# ---------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=media-files
# อายุของ signed URL หน่วยเป็นวินาที
SIGNED_URL_TTL_SECONDS=300
# ขนาดไฟล์สูงสุดต่อไฟล์ (ไบต์) ค่าเริ่มต้น 50MB
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------
# AI (กฎเหล็กข้อ 8: ช่วยคัดกรองเท่านั้น ไม่มีสิทธิ์เปลี่ยนสถานะ)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# ผู้ช่วยตรวจและแชทในหน้าหัวหน้ากลุ่มสาระ/หัวหน้าวิชาการ
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_TEMPERATURE=0.2
TYPHOON_MAX_TOKENS=1800
# ปิดการเรียก AI ทั้งระบบได้ด้วยการตั้งเป็น false
AI_CHECK_ENABLED=true

# ---------------------------------------------------------------
# ทั่วไป
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ใช้เฉพาะช่วงพัฒนา ก่อนเชื่อม Supabase Auth: TEACHER, REVIEWER หรือ ADMIN
UDOMSASN_PREVIEW_ROLE=TEACHER
