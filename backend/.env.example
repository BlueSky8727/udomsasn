DATABASE_URL="postgresql://postgres:change_me@localhost:5432/udomsasn?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:3000
# จำนวน reverse proxy ที่เชื่อถือได้; local ใช้ 0, production ทั่วไปมักใช้ 1
TRUST_PROXY_HOPS=0
JWT_SECRET=replace_with_a_long_random_secret
# secret แยกสำหรับ HMAC รหัสยืนยัน 6 หลัก (อย่างน้อย 32 ตัวอักษร)
# ถ้าไม่ตั้ง ระบบจะใช้ JWT_SECRET เพื่อให้ติดตั้งแบบเดิมยังทำงานได้
CODE_HASH_SECRET=
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
MAX_UPLOAD_BYTES=52428800
MAX_AVATAR_BYTES=2097152

# URL ของหน้าเว็บ ใช้ประกอบลิงก์ยืนยันอีเมลที่ส่งให้ผู้สมัคร
APP_URL=http://localhost:3000

# อีเมลขาออก ถ้าไม่ตั้ง SMTP_HOST ระบบจะพิมพ์ลิงก์ยืนยันลง log แทน (ใช้ได้เฉพาะตอนพัฒนา)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@udomsasn.ac.th
